# Artalk on Railway — copy to .env for local runs; Railway sets these as service variables.
# Admin account (username admin, email admin@example.com) — the password is generated at deploy time.
ATK_ADMIN_USERS_0_PASSWORD=your-generated-admin-password
# Optional tunables (defaults are baked into the image):
# ATK_LOCALE=en
# ATK_TIMEZONE=UTC
# ATK_SITE_DEFAULT=Artalk Blog
# ATK_SITE_URL=https://your-blog.example.com
